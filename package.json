{
  "name": "url-forge-lab",
  "version": "0.1.0",
  "description": "A reversible, client-side URL compressor and static web app.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "benchmark": "node src/benchmark.js",
    "benchmark:validation": "node src/validate-benchmark.js",
    "benchmark:advanced": "node src/advanced-benchmark.js",
    "benchmark:local": "node src/local-benchmark.js",
    "benchmark:local:sample": "node src/local-benchmark.js --sample --reset --stop-after=2 && node src/local-benchmark.js --sample",
    "benchmark:global-stream": "node src/local-benchmark.js --global-stream",
    "benchmark:global-stream:sample": "node src/local-benchmark.js --global-stream --sample --reset --stop-after=2 && node src/local-benchmark.js --global-stream --sample",
    "benchmark:structure": "node src/local-benchmark.js --structure-ablation",
    "benchmark:structure:sample": "node src/local-benchmark.js --structure-ablation --sample --reset --stop-after=2 && node src/local-benchmark.js --structure-ablation --sample",
    "benchmark:final": "node src/final-output-benchmark.js --normal",
    "benchmark:final:normal": "node src/final-output-benchmark.js --normal",
    "benchmark:final:stress": "node src/final-output-benchmark.js --stress",
    "benchmark:final:context": "node src/final-output-benchmark.js --context-experiment --normal",
    "benchmark:final:sample": "node src/final-output-benchmark.js --sample --normal --reset --stop-after=2 && node src/final-output-benchmark.js --sample --normal",
    "benchmark:meta:sample": "node src/meta-benchmark.js",
    "benchmark:suffix": "node src/suffix-benchmark.js",
    "test": "node --test",
    "test:web": "node --test test/web-app.test.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  }
}
